  "item": [
    {
      "name": "Random",
      "item": [
        {
          "name": "Generate random bytes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CountByte\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/genrand",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genrand"
              ]
            },
            "description": "Generate 1–1024 random bytes. CountByte is required. 200 returns Random as hex with two characters per byte; invalid or missing CountByte returns 400 (code 1066), `INVALID_JSON_REQUEST: CountByte harus 1..1024`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and 16 hex characters', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.Random).to.be.a('string');",
                  "  pm.expect(body.Random).to.match(/^[0-9a-fA-F]{16}$/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Encrypt-Decrypt",
      "item": [
        {
          "name": "Encrypt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Plaintext\": [\n    {\n      \"Text\": \"{{plaintext}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/encrypt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "encrypt"
              ]
            },
            "description": "Encrypts one or more Plaintext items, each with Text. Requires at least one item; empty Plaintext returns 400 (code 1066), `Plaintext wajib berisi minimal satu item`. 200 returns Ciphertext items with lowercase versionkey, text, mac, and iv fields. Crypto/input errors return 501; key zone or audit unavailability returns 503."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and save encrypted fields', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const item = pm.response.json().Ciphertext[0];",
                  "  pm.collectionVariables.set('encVersionkey', item.versionkey);",
                  "  pm.collectionVariables.set('encText', item.text);",
                  "  pm.collectionVariables.set('encMac', item.mac);",
                  "  pm.collectionVariables.set('encIv', item.iv);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Decrypt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Ciphertext\": [\n    {\n      \"versionkey\": \"{{encVersionkey}}\",\n      \"text\": \"{{encText}}\",\n      \"mac\": \"{{encMac}}\",\n      \"iv\": \"{{encIv}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/decrypt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "decrypt"
              ]
            },
            "description": "Decrypts one or more Ciphertext items with lowercase versionkey, text, mac, and iv fields. Requires at least one item; empty Ciphertext returns 400 (code 1066), `Ciphertext wajib berisi minimal satu item`. Invalid item returns 501, `item <i>: ciphertext tidak valid`. 200 returns Plaintext items with lowercase text."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and plaintext returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().Plaintext[0].text).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Encrypt empty list (negative)",
