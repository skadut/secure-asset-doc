                  "  pm.collectionVariables.set('totpSecretEncrypted', body.SecretEncrypted);",
                  "  pm.expect(body['TOTP Key']).to.be.a('string').and.to.match(/^otpauth:\\/\\/totp\\/Skadut:/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
