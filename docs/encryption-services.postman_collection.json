            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Plaintext\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/encrypt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "encrypt"
              ]
            },
            "description": "Negative validation case: empty Plaintext returns 400 (code 1066) with a message containing `minimal satu item`."
          },
          "event": [
            {
              "listen": "test",
